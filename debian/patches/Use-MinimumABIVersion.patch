From: Phil Thompson <phil@riverbankcomputing.com>
Date: Tue, 13 Jan 2026 15:56:51 +0000
Subject: Use %MinimumABIVersion instead of setting the ABI in project.py.

(cherry picked from commit 89d9b15991f220742b77ba05a36d638224593849)
---
 project.py               | 8 ++------
 sip/QtCore/QtCoremod.sip | 2 ++
 2 files changed, 4 insertions(+), 6 deletions(-)

diff --git a/project.py b/project.py
index 9a3721f..be57e4f 100644
--- a/project.py
+++ b/project.py
@@ -27,10 +27,6 @@ from sipbuild import (Buildable, BuildableModule, Installable, Option,
         UserException)
 
 
-# The minimum sip module ABI version needed.
-ABI_VERSION = '12.15'
-
-
 class PyQt(PyQtProject):
     """ The PyQt5 project. """
 
@@ -39,8 +35,8 @@ class PyQt(PyQtProject):
 
         # We specify the name of the sip module because PyQt-builder doesn't
         # provide it if we are creating an sdist.
-        super().__init__(abi_version=ABI_VERSION, sip_module='PyQt5.sip',
-                dunder_init=True, tag_prefix='Qt', console_scripts=[
+        super().__init__(sip_module='PyQt5.sip', dunder_init=True,
+                tag_prefix='Qt', console_scripts=[
                     'pylupdate5 = PyQt5.pylupdate_main:main',
                     'pyrcc5 = PyQt5.pyrcc_main:main',
                     'pyuic5 = PyQt5.uic.pyuic:main'])
diff --git a/sip/QtCore/QtCoremod.sip b/sip/QtCore/QtCoremod.sip
index 6cae1ef..e77ed2b 100644
--- a/sip/QtCore/QtCoremod.sip
+++ b/sip/QtCore/QtCoremod.sip
@@ -65,6 +65,8 @@ WARRANTY OF DESIGN, MERCHANTABILITY AND FITNESS FOR A PARTICULAR PURPOSE.
 
 %Plugin PyQt5
 
+%MinimumABIVersion "12.15"
+
 %If (Py_v3)
 %DefaultEncoding "ASCII"
 %End
